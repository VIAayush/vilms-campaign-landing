# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project Settings -> API) ---------------------------------------
# Public by design: the URL and the publishable/anon key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Server-only --------------------------------------------------------------
# Shared secret between this server and the database's ingest functions. The
# database stores only its SHA-256 hash (see README "Rotate the ingest secret").
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LEAD_INGEST_SECRET=

# Optional: Cloudflare Turnstile. Leave both empty to run without a CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://vilms.in
# Where "Start your 14-day trial" sends people after they leave their details.
NEXT_PUBLIC_TRIAL_URL=https://vilms.in/start
# Optional real scheduling link (Calendly, Google Calendar booking page...).
# When empty, the success screen says the team will call to schedule.
NEXT_PUBLIC_DEMO_BOOKING_URL=

# --- Analytics (optional; nothing loads when empty) ---------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
